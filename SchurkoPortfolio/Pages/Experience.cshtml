@page
@model ExperienceModel
@{
    ViewData["Title"] = "Experience";
}

<section class="page-hero page-container">
    <div class="eyebrow">CAREER TIMELINE</div>
    <h1>Experience that compounds.</h1>
    <p>Selected roles, responsibilities, and the kind of problems I've enjoyed solving.</p>
</section>

<section class="timeline page-container">
    <article class="timeline-item">
        <div class="timeline-date">2023 — Present</div>
        <div class="timeline-node"></div>
        <div class="timeline-content glass-card">
            <div class="role-header">
                <div><h2>Senior Software Developer</h2><h3>Northstar Digital</h3></div>
                <span class="role-type">FULL-TIME</span>
            </div>
            <p>Lead developer for customer-facing web platforms and internal systems serving a growing user base.</p>
            <ul>
                <li>Designed ASP.NET Core APIs and domain services using clean architecture principles.</li>
                <li>Improved application reliability through automated testing, structured logging, and observability.</li>
                <li>Partnered with product and design to turn ambiguous requirements into maintainable features.</li>
            </ul>
            <div class="tag-row"><span>C#</span><span>ASP.NET Core</span><span>SQL Server</span><span>Azure</span></div>
        </div>
    </article>

    <article class="timeline-item">
        <div class="timeline-date">2020 — 2023</div>
        <div class="timeline-node"></div>
        <div class="timeline-content glass-card">
            <div class="role-header">
                <div><h2>Software Developer</h2><h3>Vertex Systems</h3></div>
                <span class="role-type">FULL-TIME</span>
            </div>
            <p>Built business applications and integrations for operations, reporting, and customer workflows.</p>
            <ul>
                <li>Delivered reusable APIs and data-access components across multiple products.</li>
                <li>Modernized legacy modules and reduced deployment friction with CI/CD automation.</li>
                <li>Worked closely with QA to establish pragmatic regression and integration coverage.</li>
            </ul>
            <div class="tag-row"><span>.NET</span><span>REST</span><span>Docker</span><span>GitHub Actions</span></div>
        </div>
    </article>

    <article class="timeline-item">
        <div class="timeline-date">2018 — 2020</div>
        <div class="timeline-node"></div>
        <div class="timeline-content glass-card">
            <div class="role-header">
                <div><h2>Junior Software Developer</h2><h3>Blue Peak Software</h3></div>
                <span class="role-type">FULL-TIME</span>
            </div>
            <p>Started out building internal tools and customer features while developing strong engineering fundamentals.</p>
            <ul>
                <li>Implemented UI features, database queries, and small API endpoints.</li>
                <li>Learned code review, source control workflows, debugging, and production support.</li>
                <li>Helped document recurring technical issues and improve onboarding for new developers.</li>
            </ul>
            <div class="tag-row"><span>C#</span><span>JavaScript</span><span>SQL</span><span>Git</span></div>
        </div>
    </article>
</section>
