@page
@model SchurkoPortfolio.Pages.Admin.DocDbModel
@{
}

<div>
    <h3>Message:</h3> @Model.SuccessMessage
    <br/> 

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <span>Error: </span> @Model.ErrorMessage
    }

    <br /><h2>Image Document Upload</h2>

    <form method="post" enctype="multipart/form-data">

        <span>Title: </span>
        <input type="text" asp-for="@Model.ImageUploadRequest.Title" />

        <span>Description: </span>
        <textarea asp-for="@Model.ImageUploadRequest.Description"></textarea>

        <span>Tags: (comma-separated)</span>
        <input type="text" asp-for="@Model.ImageUploadRequest.Tags" />

        <span>Image Upload:</span>
        <input type="file" asp-for="@Model.ImageUploadRequest.File" />

        <button type="submit">Upload</button>

    </form>

    <h2>Uploaded Images</h2>

    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Tags</th>
                <th>Image</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var image in Model.ImageDocuments)
            {
                <tr>
                    <td>@image.Title</td>
                    <td>@image.Description</td>
                    <td>@string.Join(", ", image.Tags)</td>
                    <td>
                        <img src="data:@image.ContentType;base64,@image.Base64Data"
                             alt="@image.FileName" width="100px"/>
                    </td>
                </tr>
            }
        </tbody>

</div>