<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Software developer portfolio, experience, resume, and contact information." />
    <title>@ViewData["Title"] · Brett Schurko</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
     }
    <div class="chrome-orb orb-one"></div>
    <div class="chrome-orb orb-two"></div>

    <header class="site-header">
        <nav class="nav-shell">
            <a class="brand" asp-page="/Index" aria-label="Brett Schurko home">
                <span class="brand-mark">&lt;/&gt;</span>
                <span>Brett Schurko</span>
            </a>

            <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
            
            <div class="nav-links">
                <a class="@(currentPage == "/Index"
                        ? "nav-cta"
                        : "")" asp-page="/Index">Home</a>
                <a class="@(currentPage == "/Experience"
                        ? "nav-cta"
                        : "")" asp-page="/Experience">Experience</a>
                <a class="@(currentPage == "/Resume"
                        ? "nav-cta"
                        : "")" asp-page="/Resume">Resume</a>
                <a class="@(currentPage == "/Contact"
                        ? "nav-cta"
                        : "")" asp-page="/Contact">Contact</a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {

                    <a class="@(currentPage == "/Admin/DocDb"
                                            ? "nav-cta"
                                            : "")" asp-page="/Admin/DocDb">DocDb</a>
                    <a class="@(currentPage == "/Admin/AiEmailChart"
                        ? "nav-cta"
                        : "")" asp-page="/Admin/AiEmailChart">AiEmailChart</a>
                    <a class="@(currentPage == "/Admin/EmailChart"
                        ? "nav-cta"
                        : "")" asp-page="/Admin/EmailChart">EmailChart</a>

                    <a class="@(currentPage == "/Account/Logout"
                                            ? "nav-cta"
                                            : "")" asp-page="/Account/Logout">Logout</a>
                }
                else
                {
                    <a class="@(currentPage == "/Account/Login"
                                            ? "nav-cta"
                                            : "")" asp-page="/Account/Login">Login</a>
                }
                 
            </div>
        </nav>
    </header>

    <main>
        
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div>
            <strong>Brett Schurko</strong>
            <span>Software Developer · Builder · Problem Solver</span> 
        </div>
        <div class="footer-meta">© @DateTime.UtcNow.Year · Built with ASP.NET Core</div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
