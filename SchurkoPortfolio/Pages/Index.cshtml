@page
@model IndexModel
@{
    ViewData["Title"] = "Software Developer";
}

<section class="hero page-container">
    <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> AVAILABLE FOR SELECT PROJECTS</div>
        <h1>Software that feels <span>engineered.</span></h1>
        <p class="hero-lede">
            I'm Brett Schurko, a software developer focused on building reliable web applications,
            thoughtful APIs, and polished developer experiences.
        </p>
        <div class="hero-actions">
            <a class="button button-primary" asp-page="/Experience">Explore my experience</a>
            <a class="button button-ghost" asp-page="/Resume">View resume <span>↗</span></a>
        </div>
        <div class="hero-stats">
            <div><strong>14+</strong><span>Years building software</span></div>
            <div><strong>30+</strong><span>Projects shipped</span></div>
            <div><strong>99.9%</strong><span>Production mindset</span></div>
        </div>
    </div>

    <div class="hero-visual">
        <div class="terminal-card">
            <div class="terminal-top"><span></span><span></span><span></span><small>developer.cs</small></div>
            <pre><code><span class="code-keyword">public</span> <span class="code-type">class</span> Developer
{
    <span class="code-keyword">public</span> <span class="code-type">string</span> Focus
        =&gt; <span class="code-string">"Clean architecture"</span>;

    <span class="code-keyword">public</span> <span class="code-type">string[]</span> Stack
        =&gt; [<span class="code-string">"C#"</span>, <span class="code-string">"ASP.NET"</span>,
            <span class="code-string">"SQL"</span>, <span class="code-string">"Azure"</span>];
}</code></pre>
        </div>
        <div class="orbit-ring ring-a"></div>
        <div class="orbit-ring ring-b"></div>
    </div>
</section>

<section class="section page-container">
    <div class="section-heading">
        <div>
            <div class="eyebrow">CORE CAPABILITIES</div>
            <h2>From architecture to interface.</h2>
        </div>
        <p>Practical engineering with an eye for maintainability, performance, and visual polish.</p>
    </div>

    <div class="capability-grid">
        <article class="glass-card">
            <div class="card-icon">01</div>
            <h3>Backend Engineering</h3>
            <p>ASP.NET Core, REST APIs, authentication, background services, and SQL-backed systems.</p>
            <div class="tag-row"><span>C#</span><span>.NET</span><span>SQL</span></div>
        </article>
        <article class="glass-card">
            <div class="card-icon">02</div>
            <h3>Web Applications</h3>
            <p>Responsive interfaces with semantic HTML, modern CSS, JavaScript, and accessible UX.</p>
            <div class="tag-row"><span>Razor</span><span>AngularJS</span><span>ReactJS</span><span>CSS</span><span>JS</span></div>
        </article>
        <article class="glass-card">
            <div class="card-icon">03</div>
            <h3>Cloud & Delivery</h3>
            <p>Deployment automation, observability, CI/CD, containerization, and production operations.</p>
            <div class="tag-row"><span>Azure</span><span>Docker</span><span>CI/CD</span></div>
        </article>
    </div>
</section>

<section class="quote-section">
    <div class="page-container quote-card">
        <div class="quote-mark">“</div>
        <blockquote>Good software should be understandable six months after you wrote it.</blockquote>
        <p>— Engineering principle</p>
    </div>
</section>
